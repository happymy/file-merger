{
  "excludeDirs": [
    {
      "pattern": ".git",
      "enabled": true
    },
    {
      "pattern": ".github",
      "enabled": true
    },
    {
      "pattern": "node_modules",
      "enabled": true
    },
    {
      "pattern": "out",
      "enabled": true
    }
  ],
  "excludeFiles": [
    {
      "pattern": ".gitattributes",
      "enabled": true
    },
    {
      "pattern": ".gitignore",
      "enabled": true
    },
    {
      "pattern": ".file-merger-config.json",
      "enabled": true
    },
    {
      "pattern": "LICENSE",
      "enabled": true
    }
  ],
  "excludeBinary": false,
  "ignoreHidden": false,
  "compressOutput": false,
  "maxCharsPerPart": 200000,
  "splitPartFooter": "请等我继续输入。",
  "whiteListExts": [],
  "maxFileSizeKB": 0,
  "customFooter": "检查代码错误、业务逻辑和安全审计。",
  "outputFileName": "merged-{timestamp}.md"
}